# Copie para deploy/.env e preencha. Gere segredos com: openssl rand -hex 32
# Use só letras e números nas senhas (hex serve), para não quebrar as URLs de conexão.

# --- Domínios ---
# Domínio raiz do produto (o front na Vercel e as páginas dos usuários em *.DOMINIO).
ROOT_DOMAIN=moonlight.gabrielbarbosadev.com.br
# Endereço público do front (origem permitida no CORS e base do checkout).
WEB_URL=https://moonlight.gabrielbarbosadev.com.br
# Domínio que o Caddy publica para a API, apontando para o IP da VPS.
API_DOMAIN=api.moonlight.gabrielbarbosadev.com.br
# Endereço público da API. As URLs das imagens enviadas são montadas a partir dele.
API_URL=https://api.moonlight.gabrielbarbosadev.com.br

# --- Banco e cache (internos, não ficam expostos na internet) ---
POSTGRES_USER=moonlight
POSTGRES_PASSWORD=troque-por-um-hex-de-64-caracteres
POSTGRES_DB=moonlight
REDIS_PASSWORD=troque-por-um-hex-de-64-caracteres

# --- Segredos da aplicação (mínimo 32 caracteres) ---
SESSION_SECRET=troque-por-um-hex-de-64-caracteres
BILLING_WEBHOOK_SECRET=troque-por-um-hex-de-64-caracteres

# --- Moderação de imagens ---
# Recusa uploads com conteúdo adulto (modelo local, a API chega a cerca de 200 MB de RAM no total).
NSFW_CHECK_ENABLED=true
NSFW_THRESHOLD=0.6

# --- Proxy reverso ---
# O Caddy fica na frente da API: 1 proxy confiável.
TRUST_PROXY=1

# --- Código de 2FA (Pygmy) ---
# O Pygmy envia e valida os códigos. A chave é a API key do Moonlight no painel dele.
PYGMY_URL=https://pygmy.gabrielbarbosadev.com.br
PYGMY_API_KEY=
PYGMY_APP_NAME=Moonlight

# --- E-mail (SMTP real, usado para os avisos de reserva) ---
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
# Use true somente se a porta for 465.
SMTP_SECURE=false
SMTP_USER=usuario
SMTP_PASS=senha
MAIL_FROM="Moonlight <nao-responda@gabrielbarbosadev.com.br>"

# --- Backoffice ---
# E-mails promovidos a SUPERADMIN ao confirmar o código de 2FA.
SUPERADMIN_EMAILS=voce@gabrielbarbosadev.com.br

# --- Billing ---
# O único provedor hoje é o sandbox (pagamento simulado). Deixe true para a demonstração
# funcionar em produção; com false, o checkout simulado responde 404.
BILLING_SANDBOX_ENABLED=true
