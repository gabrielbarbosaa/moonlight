# --- Domínio ---
# Em dev, subdomínios *.localhost funcionam direto no navegador.
ROOT_DOMAIN=localhost:3000

# --- API ---
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Postgres ---
POSTGRES_USER=sitebuilder
POSTGRES_PASSWORD=sitebuilder
POSTGRES_DB=sitebuilder
DATABASE_URL=postgresql://sitebuilder:sitebuilder@localhost:5433/sitebuilder?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6380

# --- E-mail (Mailpit, caixa de entrada fake: http://localhost:8026) ---
SMTP_HOST=localhost
SMTP_PORT=1026
MAIL_FROM="SiteBuilder <no-reply@sitebuilder.local>"

# --- Armazenamento (MinIO, console: http://localhost:9001) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sitebuilder
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Backoffice ---
# E-mails (separados por vírgula) promovidos a SUPERADMIN ao confirmar o código de 2FA.
SUPERADMIN_EMAILS=admin@sitebuilder.local

# --- Sessão ---
# Gere um valor aleatório: openssl rand -hex 32
SESSION_SECRET=troque-este-valor-em-dev

# --- Billing (sandbox) ---
# Segredo que assina os webhooks do provedor de pagamento. Gere com: openssl rand -hex 32
BILLING_WEBHOOK_SECRET=troque-este-valor-em-dev

# --- Proxy reverso ---
# Quantos proxies confi�veis existem na frente da API (ex.: 1), para o IP real chegar aos limites de taxa.
# Deixe vazio em desenvolvimento local.
TRUST_PROXY=
