# --- Domínio ---
# Em dev, subdomínios *.localhost funcionam direto no navegador.
ROOT_DOMAIN=localhost:3000

# --- API ---
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Postgres ---
POSTGRES_USER=moonlight
POSTGRES_PASSWORD=moonlight
POSTGRES_DB=moonlight
DATABASE_URL=postgresql://moonlight:moonlight@localhost:5433/moonlight?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6380

# --- E-mail (Mailpit, caixa de entrada fake: http://localhost:8026) ---
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Moonlight <no-reply@moonlight.local>"

# --- Imagens enviadas ---
# Pasta onde a API grava as imagens (relativa a apps/api em dev). A URL pública usa API_URL.
MEDIA_DIR=storage/media
# Recusa imagens com conteúdo adulto (modelo NSFWJS local, sem custo). Use false para desligar em dev.
NSFW_CHECK_ENABLED=true
# Soma das probabilidades Porn + Hentai a partir da qual a imagem é recusada (0 a 1).
NSFW_THRESHOLD=0.6

# --- Backoffice ---
# E-mails (separados por vírgula) promovidos a SUPERADMIN ao confirmar o código de 2FA.
SUPERADMIN_EMAILS=admin@moonlight.local

# --- Sessão ---
# Gere um valor aleatório: openssl rand -hex 32
SESSION_SECRET=troque-este-valor-em-dev

# --- Billing (sandbox) ---
# Segredo que assina os webhooks do provedor de pagamento. Gere com: openssl rand -hex 32
BILLING_WEBHOOK_SECRET=troque-este-valor-em-dev
# Em produção, o checkout simulado só responde se esta variável for true.
BILLING_SANDBOX_ENABLED=

# --- Proxy reverso ---
# Quantos proxies confiáveis existem na frente da API (ex.: 1), para o IP real chegar aos limites de taxa.
# Deixe vazio em desenvolvimento local.
TRUST_PROXY=
