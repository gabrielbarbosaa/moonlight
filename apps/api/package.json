{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "prisma migrate deploy && node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"sem testes ainda em api\"",
    "seed:moonbarber": "node --env-file=../../.env scripts/seed-moonbarber.mjs --force",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "prisma": {
    "seed": "node scripts/seed-moonbarber.mjs"
  },
  "dependencies": {
    "@moonlight/schemas": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4",
    "@nestjs/swagger": "^7",
    "@prisma/client": "^6.1.0",
    "@tensorflow/tfjs": "4.22.0",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "ioredis": "^6.0.0",
    "nestjs-zod": "^5.6.0",
    "nodemailer": "^10.5.0",
    "nsfwjs": "4.4.0",
    "prisma": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^1",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "dotenv-cli": "^11.1.0",
    "typescript": "^5.7.2"
  }
}
