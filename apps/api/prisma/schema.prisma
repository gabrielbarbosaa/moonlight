generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SUPERADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  passwordHash  String
  emailVerified Boolean    @default(false)
  role          UserRole   @default(USER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenants       Tenant[]
  authCodes     AuthCode[]
  auditLogs     AuditLog[]

  @@map("users")
}

/// Códigos de 2FA enviados por e-mail. Guarda apenas o hash do código.
model AuthCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("auth_codes")
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  suspendedReason String?
  suspendedAt     DateTime?
  ownerId   String       @db.Uuid
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  page      Page?
  analytics AnalyticsDaily[]
  reports   TenantReport[]

  bookingEnabled Boolean @default(false)
  timezone       String  @default("America/Sao_Paulo")
  bookingServices BookingService[]
  availability    AvailabilityRule[]
  bookings        Booking[]

  @@index([ownerId])
  @@index([status])
  @@map("tenants")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

/// Tipo de atendimento oferecido na agenda (nome e duração).
model BookingService {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  name            String
  durationMinutes Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@index([tenantId])
  @@map("booking_services")
}

/// Janela semanal de atendimento, em minutos desde 00:00 no fuso do tenant.
model AvailabilityRule {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, weekday])
  @@map("availability_rules")
}

/// Reserva. A exclusion constraint (na migration) impede sobreposição por tenant.
model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  serviceId     String        @db.Uuid
  startsAt      DateTime      @db.Timestamptz(3)
  endsAt        DateTime      @db.Timestamptz(3)
  customerName  String
  customerEmail String
  notes         String?
  status        BookingStatus @default(CONFIRMED)
  createdAt     DateTime      @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service       BookingService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([tenantId, startsAt])
  @@map("bookings")
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Denúncia feita por um visitante contra uma página pública.
model TenantReport {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  resolvedAt   DateTime?
  resolvedById String?      @db.Uuid
  createdAt    DateTime     @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tenantId])
  @@map("tenant_reports")
}

/// Registro de ações administrativas (suspensões, reativações, denúncias).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}

/// Agregado diário (UTC) de visitas e cliques, consolidado a partir do Redis.
model AnalyticsDaily {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  date           DateTime @db.Date
  views          Int      @default(0)
  uniqueVisitors Int      @default(0)
  clicks         Json     @default("{}")

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@map("analytics_daily")
}

/// A página do tenant: rascunho e versão publicada em JSONB.
model Page {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @unique @db.Uuid
  draft         Json
  published     Json?
  schemaVersion Int           @default(1)
  publishedAt   DateTime?
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions      PageVersion[]

  @@map("pages")
}

/// Histórico imutável de cada publicação.
model PageVersion {
  id            String   @id @default(uuid()) @db.Uuid
  pageId        String   @db.Uuid
  content       Json
  schemaVersion Int
  createdAt     DateTime @default(now())

  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@map("page_versions")
}
