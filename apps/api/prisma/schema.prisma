generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SUPERADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String
  emailVerified Boolean  @default(false)
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenants      Tenant[]
  authCodes    AuthCode[]
  auditLogs    AuditLog[]
  subscription Subscription?
  mediaAssets  MediaAsset[]

  @@map("users")
}

/// Imagem enviada pelo usuário. O arquivo fica no armazenamento; aqui ficam os metadados e a cota.
model MediaAsset {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  key         String   @unique
  contentType String
  sizeBytes   Int
  width       Int
  height      Int
  createdAt   DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@map("media_assets")
}

enum PlanId {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
}

/// Assinatura do usuário. Sem linha, vale o plano FREE.
model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @unique @db.Uuid
  plan                   PlanId
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  providerSubscriptionId String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// Eventos recebidos do provedor de pagamento. A chave única garante idempotência.
model BillingEvent {
  id              String   @id @default(uuid()) @db.Uuid
  providerEventId String   @unique
  type            String
  payload         Json
  createdAt       DateTime @default(now())

  @@map("billing_events")
}

/// Códigos de 2FA enviados por e-mail. Guarda apenas o hash do código.
model AuthCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("auth_codes")
}

model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  slug            String       @unique
  name            String
  status          TenantStatus @default(ACTIVE)
  suspendedReason String?
  suspendedAt     DateTime?
  ownerId         String       @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  page      Page?
  analytics AnalyticsDaily[]
  reports   TenantReport[]

  bookingEnabled    Boolean            @default(false)
  timezone          String             @default("America/Sao_Paulo")
  cancelNoticeHours Int                @default(2)
  bookingServices   BookingService[]
  availability      AvailabilityRule[]
  bookings          Booking[]

  @@index([ownerId])
  @@index([status])
  @@map("tenants")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

/// Tipo de atendimento oferecido na agenda (nome e duração).
model BookingService {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  name            String
  durationMinutes Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]
  extras   BookingExtra[]

  @@index([tenantId])
  @@map("booking_services")
}

enum CancelActor {
  CUSTOMER
  OWNER
}

/// Serviço adicional de uma reserva. Guarda nome e duração da época para o histórico não mudar.
model BookingExtra {
  id              String   @id @default(uuid()) @db.Uuid
  bookingId       String   @db.Uuid
  serviceId       String   @db.Uuid
  name            String
  durationMinutes Int
  createdAt       DateTime @default(now())

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service BookingService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("booking_extras")
}

/// Janela semanal de atendimento, em minutos desde 00:00 no fuso do tenant.
model AvailabilityRule {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  weekday     Int
  startMinute Int
  endMinute   Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, weekday])
  @@map("availability_rules")
}

/// Reserva. A exclusion constraint (na migration) impede sobreposição por tenant.
model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  serviceId       String        @db.Uuid
  startsAt        DateTime      @db.Timestamptz(3)
  endsAt          DateTime      @db.Timestamptz(3)
  customerName    String
  customerEmail   String
  notes           String?
  status          BookingStatus @default(CONFIRMED)
  manageTokenHash String?       @unique
  cancelledAt     DateTime?
  cancelledBy     CancelActor?
  createdAt       DateTime      @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service BookingService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  extras  BookingExtra[]

  @@index([tenantId, startsAt])
  @@map("bookings")
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Denúncia feita por um visitante contra uma página pública.
model TenantReport {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  resolvedAt   DateTime?
  resolvedById String?      @db.Uuid
  createdAt    DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tenantId])
  @@map("tenant_reports")
}

/// Registro de ações administrativas (suspensões, reativações, denúncias).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}

/// Agregado diário (UTC) de visitas e cliques, consolidado a partir do Redis.
model AnalyticsDaily {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  date           DateTime @db.Date
  views          Int      @default(0)
  uniqueVisitors Int      @default(0)
  clicks         Json     @default("{}")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@map("analytics_daily")
}

/// A página do tenant: rascunho e versão publicada em JSONB.
model Page {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @unique @db.Uuid
  draft         Json
  published     Json?
  schemaVersion Int       @default(1)
  publishedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions PageVersion[]

  @@map("pages")
}

/// Histórico imutável de cada publicação.
model PageVersion {
  id            String   @id @default(uuid()) @db.Uuid
  pageId        String   @db.Uuid
  content       Json
  schemaVersion Int
  createdAt     DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@map("page_versions")
}
